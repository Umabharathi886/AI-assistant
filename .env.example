# === LLM Provider ===
# "groq" = free, no credit card needed (default). "openai" = paid.
LLM_PROVIDER=groq

# --- Groq (free) ---
# Get a free key at https://console.groq.com (API Keys -> Create API Key)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (paid, optional) ---
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# === Embeddings (ChromaDB knowledge base) ===
# "huggingface" = free, runs locally, no API key needed (default)
# "openai" = paid, requires OPENAI_API_KEY above
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Gmail Integration (Module 4) ===
# Follow README section "Gmail Setup" to generate credentials.json via Google Cloud Console
# Place the downloaded file at: data/gmail_credentials.json
GMAIL_ENABLED=false

# === Google Drive Integration (Module 14 - Optional) ===
GDRIVE_ENABLED=false
GDRIVE_CREDENTIALS_PATH=data/gdrive_credentials.json

# === Search Provider (Module 3) ===
# Uses DuckDuckGo by default (no API key required)

# === App Config ===
CHROMA_PERSIST_DIR=data/chroma_db
SQLITE_DB_PATH=data/memory.db
